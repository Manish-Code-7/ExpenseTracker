# Copy this file to .env.local and fill in real values there.
#
# Next.js does NOT read this file — only .env, .env.local and .env.development*
# are loaded, so a value set here has no effect. Keep real secrets in
# .env.local (git-ignored); this file is committed.

# --- Database (required) ----------------------------------------------------
# Neon Console -> your project -> Connect -> pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: the `authenticated` role's connection string. Set this only after
# running neon/03_rls.sql and registering the JWKS URL in the Neon Console —
# it is what makes Row Level Security actually apply. Without it the app works
# and ownership is enforced by the tRPC layer alone.
# DATABASE_AUTHENTICATED_URL=postgresql://authenticated@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth (required) --------------------------------------------------------
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=YOUR-32-BYTE-RANDOM-SECRET
# The app's own origin. Must match in production, or OAuth callbacks and the
# links in emails point at the wrong host.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (required for password reset) ------------------------------------
# Without RESEND_API_KEY the app still runs and mail is logged to the server
# console instead of sent — fine locally, not fine in production.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_KEY
# Must be a domain you've verified with Resend. The default below only works
# for sending to your own Resend account address.
EMAIL_FROM=Ledger <onboarding@resend.dev>

# --- Google sign-in (optional) ----------------------------------------------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR-CLIENT-SECRET

# --- Assistant (optional) ---------------------------------------------------
# Powers /chat. Set either, or both — with both you get a model toggle.
# Claude Opus 5 — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-YOUR-KEY
# Gemini 3.5 Flash — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=YOUR-GOOGLE-AI-STUDIO-KEY
